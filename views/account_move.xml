<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_library" model="ir.ui.view">
        <field name="name">account.move.form.inherit.library</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="picking_id" readonly="1" invisible="not picking_id"/>
                <field name="is_penalty_invoice" readonly="1" invisible="not is_penalty_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>