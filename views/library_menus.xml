    <!-- Top Menu -->
    <menuitem id="menu_library_root" name="Library Management" sequence="10"/>

    <!-- Submenus -->
    <menuitem id="menu_library_issuance" name="Inventory" parent="menu_library_root" action="action_library_issuance" sequence="10"/>
<!--    <menuitem id="menu_library_invoices" name="Invoices" parent="menu_library_root" action="action_library_invoices" sequence="20"/>-->
    <menuitem id="menu_library_members" name="Members" parent="menu_library_root" action="action_library_members" sequence="30"/>
    <menuitem id="menu_library_books" name="Books" parent="menu_library_root" action="action_library_books" sequence="40"/>
</odoo>