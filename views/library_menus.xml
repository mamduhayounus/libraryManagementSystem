<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Window Actions -->
    <record id="action_library_books" model="ir.actions.act_window">
        <field name="name">Books / Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_book', '=', True)]</field>
        <field name="context">{'default_is_book': True}</field>
    </record>

    <record id="action_library_members" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_member', '=', True)]</field>
        <field name="context">{'default_is_member': True}</field>
    </record>

    <record id="action_library_issuance" model="ir.actions.act_window">
        <field name="name">Inventory / Issuance</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <!-- Filter: Only show pickings that contain library books -->
        <field name="domain">[('move_ids.product_id.is_book', '=', True)]</field>
    </record>

<!--    <record id="action_library_invoices" model="ir.actions.act_window">-->
