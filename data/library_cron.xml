<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Cron Job to Cancel 3-Day Expired Reservations -->
        <record id="cron_check_expired_reservations" model="ir.cron">
            <field name="name">Library: Cancel Expired Reservations (3 Days)</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expired_reservations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>